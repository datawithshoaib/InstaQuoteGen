# Copy to backend/.env and fill in what you have. Everything is optional:
# without keys the app still works (library fallback + generated gradients).

# LLM (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# "fake" runs the full pipeline with a deterministic offline model (demos, UI work)
LLM_PROVIDER=groq

# Background photos (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=

# Pipeline guard rails
MIN_QUALITY_SCORE=7.0
MAX_REWRITE_ROUNDS=2
PIPELINE_TIMEOUT_SECONDS=90

# Server
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
